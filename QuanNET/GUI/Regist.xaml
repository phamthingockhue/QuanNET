<Window x:Class="QuanNET.GUI.Regist"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanNET.GUI"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">

    <Grid Background="#F4F6F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="0 30 30 0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A1B2F" Offset="0"/>
                    <GradientStop Color="#162A45" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Keiri_NET" Foreground="#00D2FF" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="GIA NHẬP CỘT MỐC GAME THỦ" Foreground="#FFFFFF" Opacity="0.7" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="40,15,40,15">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Đăng Ký Thành Viên" Foreground="#1A1B2F" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Text="Tạo tài khoản để nhận nhiều ưu đãi giờ chơi hơn" Foreground="#A0A5B5" FontSize="13" Margin="0,0,0,20"/>

                <TextBlock Text="Họ và Tên" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,2" Margin="0,0,0,12">
                    <TextBox x:Name="txtFullName" Height="32" BorderThickness="0" VerticalContentAlignment="Center" Background="Transparent" FontSize="14" Foreground="#1A1B2F"/>
                </Border>

                <TextBlock Text="Số điện thoại" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,2" Margin="0,0,0,12">
                    <TextBox x:Name="txtPhone" Height="32" BorderThickness="0" VerticalContentAlignment="Center" Background="Transparent" FontSize="14" Foreground="#1A1B2F"/>
                </Border>

                <TextBlock Text="Tên tài khoản (Username)" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,2" Margin="0,0,0,12">
                    <TextBox x:Name="txtRegUsername" Height="32" BorderThickness="0" VerticalContentAlignment="Center" Background="Transparent" FontSize="14" Foreground="#1A1B2F"/>
                </Border>

                <TextBlock Text="Mật khẩu" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,2" Margin="0,0,0,20">
                    <PasswordBox x:Name="txtRegPassword" Height="32" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Foreground="#1A1B2F"/>
                </Border>

                <Button x:Name="btnConfirmRegister" Content="XÁC NHẬN ĐĂNG KÝ" Height="42" Background="#162A45" Foreground="White" FontWeight="Bold" FontSize="14" Click="btnConfirmRegister_Click" Margin="0,0,0,15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnBackToLogin" Content="Quay lại Đăng nhập" Background="Transparent" BorderThickness="0" Foreground="#00D2FF" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="btnBackToLogin_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>