<UserControl x:Class="QuanNET.GUI.User.Naptien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanNET.GUI.User"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tự Nạp Tiền Vào Tài Khoản Hội Viên" FontSize="20" FontWeight="Bold" Foreground="#162A45" VerticalAlignment="Center" Margin="18,0"/>

        <Grid Grid.Row="1" Margin="18,10,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Left" Width="400" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Mô phỏng tính năng cộng số dư tài khoản trực tuyến." FontSize="13" Foreground="#A0A5B5" Margin="0,0,0,20"/>

                    <TextBlock Text="Số tiền cần nạp (VND):" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="#F4F6F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
                        <TextBox x:Name="txtMoneyAmount" Height="32" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Foreground="#1A1B2F" Margin="10,0,10,0"/>
                    </Border>

                    <TextBlock Text="Nhập mật khẩu tài khoản để xác nhận:" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="#F4F6F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,25">
                        <PasswordBox x:Name="txtVerifyPassword" Height="32" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Foreground="#1A1B2F" Margin="10,0,10,0"/>
                    </Border>

                    <Button x:Name="btnConfirmDeposit" Content="💵 XÁC NHẬN NẠP TIỀN" Height="42" 
                            Background="#28A745" Foreground="White" FontWeight="Bold" FontSize="14"
                            Cursor="Hand" Click="btnConfirmDeposit_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Style.Resources>
                                </Style.Resources>
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" VerticalAlignment="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="💳 THÔNG TIN VÍ" FontSize="14" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,15"/>

                    <Separator Background="#E2E8F0" Margin="0,0,0,15"/>

                    <TextBlock Text="Số dư hiện tại của bạn:" FontSize="13" Foreground="#64748B" Margin="0,0,0,5"/>

                    <TextBlock x:Name="lblCurrentBalance" Text="0 đ" FontSize="26" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,0,5"/>

                    <TextBlock Text="*Số tiền này sẽ được đồng bộ trực tiếp với máy tính bạn đang sử dụng." FontSize="11" FontStyle="Italic" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>