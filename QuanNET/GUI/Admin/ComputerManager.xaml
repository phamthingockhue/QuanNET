<UserControl x:Class="QuanNET.GUI.Admin.ComputerManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanNET.GUI.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Quản Lý Thiết Bị Máy Tính" FontSize="20" FontWeight="Bold" Foreground="#162A45" Margin="0,0,0,15"/>

            <DataGrid Grid.Row="1" x:Name="dgComputers" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" Background="#F4F6F9" 
                      BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="35"
                      SelectionChanged="dgComputers_SelectionChanged">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#162A45"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Máy" Binding="{Binding ComputerID}" Width="1*"/>
                    <DataGridTextColumn Header="Tên Máy" Binding="{Binding ComputerName}" Width="1.5*"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding ComputerStatus}" Width="1.2*"/>
                    <DataGridTextColumn Header="Đơn Giá/h" Binding="{Binding ComputerMoney, StringFormat={}{0:N0} đ}" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Background="#F4F6F9" CornerRadius="15" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Thông Tin Chi Tiết" FontSize="16" FontWeight="Bold" Foreground="#162A45" Margin="0,0,0,15"/>

                    <TextBlock Text="Mã Máy Tính" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,0,15">
                        <TextBox x:Name="txtComputerID" Height="28" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"/>
                    </Border>

                    <TextBlock Text="Tên Máy Tính" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,0,15">
                        <TextBox x:Name="txtComputerName" Height="28" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"/>
                    </Border>

                    <TextBlock Text="Trạng Thái Máy" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbComputerStatus" Height="34" Margin="0,0,0,15" VerticalContentAlignment="Center" FontSize="13">
                        <ComboBoxItem Content="Trống"/>
                        <ComboBoxItem Content="Đang sử dụng"/>
                        <ComboBoxItem Content="Bảo trì"/>
                    </ComboBox>

                    <TextBlock Text="Đơn Giá Theo Giờ (VND)" Foreground="#565E73" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,0,15">
                        <TextBox x:Name="txtComputerMoney" Height="28" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"/>
                    </Border>
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="3" Height="42" Margin="0,15,0,0">
                    <Button x:Name="btnAdd" Content="Thêm Máy" Background="#28A745" Foreground="White" FontWeight="Bold" Margin="4" Click="btnAdd_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnEdit" Content="Sửa Máy" Background="#FFC107" Foreground="#1A1B2F" FontWeight="Bold" Margin="4" Click="btnEdit_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnDelete" Content="Xóa Máy" Background="#DC3545" Foreground="White" FontWeight="Bold" Margin="4" Click="btnDelete_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>