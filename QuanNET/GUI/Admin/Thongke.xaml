<UserControl x:Class="QuanNET.GUI.Admin.Thongke"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanNET.GUI.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Báo Cáo &amp; Thống Kê Doanh Thu" FontSize="22" FontWeight="Bold" Foreground="#162A45" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#F4F6F9" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#565E73"/>
                <DatePicker x:Name="dpFromDate" Width="160" Height="30" VerticalContentAlignment="Center"/>

                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="25,0,10,0" Foreground="#565E73"/>
                <DatePicker x:Name="dpToDate" Width="160" Height="30" VerticalContentAlignment="Center"/>

                <Button x:Name="btnFilter" Content="📊 Thống Kê" Width="120" Height="32" Margin="30,0,0,0" 
                        Background="#162A45" Foreground="White" FontWeight="Bold" Click="btnFilter_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#E6F4EA" BorderBrush="#28A745" BorderThickness="1" CornerRadius="12" Padding="20,15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="TỔNG DOANH THU PHÒNG MÁY" FontSize="12" FontWeight="Bold" Foreground="#137333"/>
                    <TextBlock x:Name="lblTotalRevenue" Text="0 đ" FontSize="28" FontWeight="Bold" Foreground="#137333" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock Text="📈" FontSize="36" Margin="50,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Chi tiết doanh thu thu về theo từng thiết bị:" FontSize="14" FontWeight="SemiBold" Foreground="#162A45" Margin="0,0,0,10"/>

            <DataGrid Grid.Row="1" x:Name="dgRevenueDetails" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" Background="White" 
                      BorderBrush="#E2E8F0" RowHeight="35" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F4F6F9">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Máy" Binding="{Binding ComputerID}" Width="1*"/>
                    <DataGridTextColumn Header="Tên Máy Tính" Binding="{Binding ComputerName}" Width="2*"/>
                    <DataGridTextColumn Header="Tổng Số Lượt Thuê" Binding="{Binding TotalRentCount}" Width="1.5*"/>
                    <DataGridTextColumn Header="Tổng Thời Gian Sử Dụng" Binding="{Binding TotalHoursDisplay}" Width="2*"/>
                    <DataGridTextColumn Header="Tổng Tiền Thu Được" Binding="{Binding Revenue, StringFormat={}{0:N0} đ}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#137333"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>